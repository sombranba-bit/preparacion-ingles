rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function firmado() {
      return request.auth != null;
    }

    // Un grupo es visible solo para quien ya es miembro
    function miembro(c) {
      return exists(/databases/$(database)/documents/grupos/$(c)/miembros/$(request.auth.uid));
    }

    // Progreso de cada persona: solo lo lee y lo escribe ella
    match /usuarios/{uid} {
      allow read: if firmado() && request.auth.uid == uid;
      allow create, update: if firmado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['datos', 'actualizado', 'grupos'])
        && (!('datos' in request.resource.data) || (request.resource.data.datos is string && request.resource.data.datos.size() < 900000))
        && (!('grupos' in request.resource.data) || request.resource.data.grupos is list);

      // Borrar la cuenta: la propia persona borra su progreso
      allow delete: if firmado() && request.auth.uid == uid;

      // Copias de seguridad: una por semana (AAAA-MM-DD) o una al restaurar; nunca se modifican
      match /copias/{semana} {
        allow read, delete: if firmado() && request.auth.uid == uid;
        allow create: if firmado() && request.auth.uid == uid
          && (semana.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') || semana.matches('^antes-de-restaurar-[0-9]+$'))
          && request.resource.data.keys().hasOnly(['datos', 'creada', 'semana'])
          && request.resource.data.semana == semana
          && request.resource.data.datos is string && request.resource.data.datos.size() < 900000;
      }
    }

    // Liga semanal global: todas las personas registradas la ven; cada una escribe solo su fila
    match /ligaSemanal/{id} {
      allow read: if firmado();
      allow create, update: if firmado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'semana', 'xp', 'actualizado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 40
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 1000000
        && id == request.resource.data.semana + '_' + request.auth.uid;
      allow delete: if firmado() && resource.data.uid == request.auth.uid;
    }

    // Grupos de amigos: el código de invitación es el único modo de entrar.
    // Solo se puede leer un grupo por su código (get), nunca listar todos.
    match /grupos/{c} {
      allow get: if firmado();
      allow create: if firmado() && request.resource.data.creador == request.auth.uid
        && request.resource.data.keys().hasOnly(['nombre', 'creador', 'creado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 30;

      match /miembros/{uid} {
        allow read: if firmado() && miembro(c);
        allow create: if firmado() && request.auth.uid == uid && request.resource.data.uid == uid
          && exists(/databases/$(database)/documents/grupos/$(c))
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'unido'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40;
        allow delete: if firmado() && request.auth.uid == uid;
      }

      // Puntos semanales de cada miembro: solo los ven los miembros del grupo
      match /xp/{uid} {
        allow read: if firmado() && miembro(c);
        allow create, update: if firmado() && request.auth.uid == uid && request.resource.data.uid == uid && miembro(c)
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'semana', 'xp', 'actualizado'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
          && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 1000000;
        allow delete: if firmado() && request.auth.uid == uid;
      }
    }

    // Todo lo demás: denegado
  }
}
